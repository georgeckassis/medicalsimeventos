# Copiá este archivo a .env.local y completá los valores reales.
# .env.local nunca se commitea (ya está en .gitignore).

# --- Base de datos ---
# Postgres propio (Vercel Storage / Neon). Si conectás la base desde Vercel →
# Storage, esta variable se carga sola en producción. Las tablas se crean
# solas la primera vez que arranca la app.
DATABASE_URL=

# --- Sesiones ---
# Clave larga y aleatoria para firmar las sesiones (ej. la salida de
# `openssl rand -hex 32`). Si se deja vacía se deriva de DATABASE_URL.
SESSION_SECRET=

# --- Acceso super admin (solo MedicalSim) ---
# Se crea una única vez al arrancar, si no existe. Después la contraseña se
# cambia desde "Mi cuenta" dentro de la app (cambiar esta variable NO pisa
# una contraseña ya cambiada).
SUPERADMIN_EMAIL=george@medicalsim.com.ar
SUPERADMIN_PASSWORD=

# --- URL pública de la app ---
# Se usa en los links de los mails de alerta y en el QR de inscripción.
# Ej: https://eventos.medicalsim.com.ar
APP_URL=

# --- Mails de alerta (Gmail por SMTP) ---
# Misma cuenta que el panel interno: contraseña de aplicación de Google
# (Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de
# aplicaciones), NO la contraseña normal de la cuenta.
SMTP_USER=
SMTP_APP_PASSWORD=

# --- WhatsApp (opcional, queda preparado) ---
# Cuando tengan WhatsApp Business (Meta Cloud API) aprobado, completar estas
# variables y los avisos salen también por WhatsApp a los teléfonos cargados
# en cada usuario. WHATSAPP_TEMPLATE es el nombre de una plantilla aprobada
# con un único parámetro {{1}} en el cuerpo (ahí va el texto de la alerta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_IDIOMA=es_AR

# --- Revisión programada de alertas (solo si el hosting no es un servidor permanente) ---
# Secreto que tiene que mandar quien llame a /api/cron/alertas
# (header "Authorization: Bearer <CRON_SECRET>"). Vercel Cron lo manda solo.
CRON_SECRET=
